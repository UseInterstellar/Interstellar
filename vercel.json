{
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "functions": {
    "src/server.js": {
      "includeFiles": "{dist/**,dist/.runtime/**,static/decoy/**}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/src/server.js"
    }
  ]
}
